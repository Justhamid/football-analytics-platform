FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir streamlit pandas numpy scikit-learn==1.8.0

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

COPY app.py .

RUN mkdir -p models && curl -L -o models/model_projection_carriere.pkl \
    https://github.com/Justhamid/football-analytics-platform/releases/download/V1.0-model/model_projection_carriere.pkl

EXPOSE 8501

CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]